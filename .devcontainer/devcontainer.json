{
  "name": "Patchbay",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install -r requirements-dev.txt",
  "postStartCommand": "nohup python -m patchbay panel --recorded --port 8093 > /tmp/panel.log 2>&1 &",
  "forwardPorts": [8093],
  "portsAttributes": {
    "8093": {
      "label": "Patchbay patch panel (recorded session)",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
